model Issue {
  id                   String             @id @default(dbgenerated("concat('isu-', gen_random_uuid())"))
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt @default(now())
  type                 IssueType
  muted                Boolean            @default(false)
  resolved             Boolean            @default(false)

  @@schema("issue")
}
