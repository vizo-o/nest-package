{
    "name": "@vizo-o/nest-package",
    "version": "0.1.51",
    "description": "NestJS utilities and shared code for Vizo applications",
    "bin": {
        "schema-generator": "./dist/src/prisma/schema-generator.js",
        "deploy": "./dist/src/deploy.js",
        "migrate": "./dist/src/migrate.js"
    },
    "files": [
        "dist",
        "src/prisma/schemas"
    ],
    "exports": {
        "./event": {
            "types": "./dist/src/event/index.d.ts",
            "default": "./dist/src/event/index.js"
        },
        "./event/app-entities": {
            "types": "./dist/src/event/app.entities.d.ts",
            "default": "./dist/src/event/app.entities.js"
        },
        "./prisma": {
            "types": "./dist/src/prisma/index.d.ts",
            "default": "./dist/src/prisma/index.js"
        },
        "./prisma/schemas/*": "./src/prisma/schemas/*",
        "./aws": {
            "types": "./dist/src/aws/index.d.ts",
            "default": "./dist/src/aws/index.js"
        },
        "./spec-types": {
            "types": "./dist/src/spec/index.d.ts",
            "default": "./dist/src/spec/index.js"
        },
        "./api": {
            "types": "./dist/src/api/index.d.ts",
            "default": "./dist/src/api/index.js"
        },
        "./logger-v2": {
            "types": "./dist/src/logger-v2/index.d.ts",
            "default": "./dist/src/logger-v2/index.js"
        },
        "./trace": {
            "types": "./dist/src/trace/index.d.ts",
            "default": "./dist/src/trace/index.js"
        }
    },
    "scripts": {
        "build": "tsc",
        "watch": "tsc -w",
        "lint": "oxlint src test -c node_modules/@vizo-o/dev-tools/oxlint-config/oxlintrc.node.json",
        "lint:fix": "oxlint src test -c node_modules/@vizo-o/dev-tools/oxlint-config/oxlintrc.node.json --fix",
        "audit:high": "npm audit --audit-level=high",
        "type-check": "tsc --noEmit",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage",
        "pre-release": "node scripts/pre-release.mjs",
        "release": "release-it",
        "release:ci": "npm run pre-release && release-it --ci",
        "typecheck": "tsc --noEmit",
        "typecheck:native": "tsgo --noEmit 2>/dev/null || tsc --noEmit"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/vizo-o/nest-package.git"
    },
    "author": "Gilaad Elstein",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/vizo-o/nest-package/issues"
    },
    "homepage": "https://github.com/vizo-o/nest-package#readme",
    "publishConfig": {
        "registry": "https://npm.pkg.github.com"
    },
    "dependencies": {
        "@aws-sdk/client-cloudformation": "^3.758.0",
        "@aws-sdk/client-cloudwatch-logs": "^3.758.0",
        "@aws-sdk/client-cognito-identity-provider": "^3.760.0",
        "@aws-sdk/client-dynamodb": "^3.758.0",
        "@aws-sdk/client-ecs": "^3.766.0",
        "@aws-sdk/client-lambda": "^3.758.0",
        "@aws-sdk/client-pinpoint-sms-voice-v2": "^3.758.0",
        "@aws-sdk/client-s3": "^3.758.0",
        "@aws-sdk/client-secrets-manager": "^3.758.0",
        "@aws-sdk/client-sesv2": "^3.758.0",
        "@aws-sdk/client-sns": "^3.758.0",
        "@aws-sdk/client-sqs": "^3.758.0",
        "@aws-sdk/client-ssm": "^3.759.0",
        "@aws-sdk/rds-signer": "^3.758.0",
        "@aws-sdk/s3-request-presigner": "^3.758.0",
        "@nestjs/common": "^11.1.17",
        "@nestjs/core": "^11.1.17",
        "@types/aws-lambda": "^8.10.147",
        "@types/jsonwebtoken": "^9.0.9",
        "chalk": "^4.1.2",
        "cron-validate": "^1.4.5",
        "dotenv": "^16.4.7",
        "jsonwebtoken": "^9.0.2",
        "jwks-rsa": "^3.1.0",
        "mathjs": "^15.2.0",
        "nest-winston": "^1.10.2",
        "pluralize": "^8.0.0",
        "winston": "^3.17.0",
        "winston-cloudwatch": "^6.3.0",
        "yargs": "^17.7.2"
    },
    "devDependencies": {
        "@nestjs/testing": "^11.1.17",
        "@testcontainers/localstack": "^11.8.1",
        "@types/jest": "^30.0.0",
        "@types/node": "^22.13.10",
        "@types/pluralize": "^0.0.33",
        "@types/yargs": "^17.0.33",
        "@typescript/native-preview": "^7.0.0-dev",
        "@vizo-o/dev-tools": "^1.0.64",
        "jest": "^30.2.0",
        "oxlint": "^1.75.0",
        "prettier": "^3.4.2",
        "release-it": "^19.0.3",
        "ts-jest": "^29.4.5",
        "typescript": "~5.8.2"
    },
    "overrides": {
        "lodash": ">=4.17.24",
        "flatted": ">=3.4.2",
        "brace-expansion": "5.0.8",
        "fast-xml-parser": ">=5.7.0",
        "minimatch": ">=10.2.1",
        "file-type": ">=21.3.1",
        "undici": ">=7.28.0 <8.0.0",
        "path-to-regexp": ">=8.4.0",
        "tmp": ">=0.2.7",
        "protobufjs": ">=7.6.3"
    }
}
